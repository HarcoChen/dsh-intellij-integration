{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsh-jev-integration:protocol:1.1",
  "title": "DSH Jev Runtime integration protocol",
  "type": "object",
  "$defs": {
    "loopGuardConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "triggerThreshold", "noProgressThreshold", "pLoopThreshold", "minConfidence", "cooldownSteps", "maxHistory", "deferExactRepeats", "requestTimeoutMs", "include", "exclude"],
      "properties": {
        "enabled": { "type": "boolean" },
        "triggerThreshold": { "type": "integer", "minimum": 1, "maximum": 120 },
        "noProgressThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "pLoopThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "minConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "cooldownSteps": { "type": "integer", "minimum": 1, "maximum": 120 },
        "maxHistory": { "type": "integer", "minimum": 1, "maximum": 120 },
        "deferExactRepeats": { "type": "boolean" },
        "requestTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "include": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "resultShaperConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "shapeTools", "thresholdChars", "maxPerTurn", "keepKinds", "minKindConfidence", "maxClusters", "sampleChars", "requestTimeoutMs"],
      "properties": {
        "enabled": { "type": "boolean" },
        "shapeTools": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "thresholdChars": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "maxPerTurn": { "type": "integer", "minimum": 1, "maximum": 120 },
        "keepKinds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "minKindConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxClusters": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "sampleChars": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "requestTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 120000 }
      }
    },
    "doneGateConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "blockThreshold", "minEvidenceItems", "requestTimeoutMs", "maxClaimChars", "cooldownTurns"],
      "properties": {
        "enabled": { "type": "boolean" },
        "blockThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "minEvidenceItems": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "requestTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "maxClaimChars": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "cooldownTurns": { "type": "integer", "minimum": 1, "maximum": 120 }
      }
    },
    "loopGuardPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "triggerThreshold": { "type": "integer", "minimum": 1, "maximum": 120 },
        "noProgressThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "pLoopThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "minConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "cooldownSteps": { "type": "integer", "minimum": 1, "maximum": 120 },
        "maxHistory": { "type": "integer", "minimum": 1, "maximum": 120 },
        "deferExactRepeats": { "type": "boolean" },
        "requestTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "include": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "resultShaperPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "shapeTools": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "thresholdChars": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "maxPerTurn": { "type": "integer", "minimum": 1, "maximum": 120 },
        "keepKinds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "minKindConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxClusters": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "sampleChars": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "requestTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 120000 }
      }
    },
    "tokenOptimizationConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "deterministicFirst", "minInputTokens", "minEstimatedSavingsTokens", "semanticFallback", "maxDecisionLatencyMs"],
      "properties": {
        "enabled": { "type": "boolean" },
        "deterministicFirst": { "type": "boolean" },
        "minInputTokens": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "minEstimatedSavingsTokens": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "semanticFallback": { "type": "boolean" },
        "maxDecisionLatencyMs": { "type": "integer", "minimum": 1, "maximum": 120000 }
      }
    },
    "tokenOptimizationPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "deterministicFirst": { "type": "boolean" },
        "minInputTokens": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "minEstimatedSavingsTokens": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "semanticFallback": { "type": "boolean" },
        "maxDecisionLatencyMs": { "type": "integer", "minimum": 1, "maximum": 120000 }
      }
    },
    "doneGatePatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "blockThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "minEvidenceItems": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "requestTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "maxClaimChars": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "cooldownTurns": { "type": "integer", "minimum": 1, "maximum": 120 }
      }
    },
    "toolPrunerConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "maxTools", "minScoreThreshold", "minConfidence", "minIntentChars", "minKeep", "maxCandidates", "requestTimeoutMs", "alwaysRetain"],
      "properties": {
        "enabled": { "type": "boolean" },
        "maxTools": { "type": "integer", "minimum": 1, "maximum": 120 },
        "minScoreThreshold": { "type": "number", "minimum": 0, "maximum": 2 },
        "minConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "minIntentChars": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "minKeep": { "type": "integer", "minimum": 1, "maximum": 120 },
        "maxCandidates": { "type": "integer", "minimum": 1, "maximum": 120 },
        "requestTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "alwaysRetain": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "toolPrunerPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "maxTools": { "type": "integer", "minimum": 1, "maximum": 120 },
        "minScoreThreshold": { "type": "number", "minimum": 0, "maximum": 2 },
        "minConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "minIntentChars": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "minKeep": { "type": "integer", "minimum": 1, "maximum": 120 },
        "maxCandidates": { "type": "integer", "minimum": 1, "maximum": 120 },
        "requestTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "alwaysRetain": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "skillRouterConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "minCandidates", "minIntentChars", "maxSkills", "maxCandidates", "minScore", "minConfidence", "nameMatchBoost", "maxAdviceChars", "requestTimeoutMs"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minCandidates": { "type": "integer", "minimum": 1, "maximum": 120 },
        "minIntentChars": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "maxSkills": { "type": "integer", "minimum": 1, "maximum": 20 },
        "maxCandidates": { "type": "integer", "minimum": 1, "maximum": 120 },
        "minScore": { "type": "number", "minimum": 0, "maximum": 2 },
        "minConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "nameMatchBoost": { "type": "number", "minimum": 0, "maximum": 2 },
        "maxAdviceChars": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "requestTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 120000 }
      }
    },
    "skillRouterPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minCandidates": { "type": "integer", "minimum": 1, "maximum": 120 },
        "minIntentChars": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "maxSkills": { "type": "integer", "minimum": 1, "maximum": 20 },
        "maxCandidates": { "type": "integer", "minimum": 1, "maximum": 120 },
        "minScore": { "type": "number", "minimum": 0, "maximum": 2 },
        "minConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "nameMatchBoost": { "type": "number", "minimum": 0, "maximum": 2 },
        "maxAdviceChars": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "requestTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 120000 }
      }
    },
    "decisionToolsConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "requestTimeoutMs", "maxStateChars", "maxQuestionChars", "maxQuestions", "maxCandidates", "maxCandidateChars", "maxResultChars"],
      "properties": {
        "enabled": { "type": "boolean" },
        "requestTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "maxStateChars": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "maxQuestionChars": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "maxQuestions": { "type": "integer", "minimum": 1, "maximum": 120 },
        "maxCandidates": { "type": "integer", "minimum": 1, "maximum": 120 },
        "maxCandidateChars": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "maxResultChars": { "type": "integer", "minimum": 1, "maximum": 120000 }
      }
    },
    "decisionToolsPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "requestTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "maxStateChars": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "maxQuestionChars": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "maxQuestions": { "type": "integer", "minimum": 1, "maximum": 120 },
        "maxCandidates": { "type": "integer", "minimum": 1, "maximum": 120 },
        "maxCandidateChars": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "maxResultChars": { "type": "integer", "minimum": 1, "maximum": 120000 }
      }
    },
    "deterministicSafetyGuardConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "maxArgumentChars", "customRules"],
      "properties": {
        "enabled": { "type": "boolean" },
        "maxArgumentChars": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "customRules": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/deterministicSafetyRule" }
        }
      }
    },
    "deterministicSafetyGuardPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "maxArgumentChars": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "customRules": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/deterministicSafetyRulePatch" }
        }
      }
    },
    "deterministicSafetyRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "pattern", "reason", "enabled"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 80 },
        "category": { "enum": ["destructive", "privilege", "credential"] },
        "pattern": { "type": "string", "minLength": 1, "maxLength": 500 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 300 },
        "credentialClass": { "enum": ["real-credential", "private-key", "suspected-credential", "placeholder"] },
        "enabled": { "type": "boolean" }
      }
    },
    "deterministicSafetyRulePatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "pattern", "reason"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 80 },
        "category": { "enum": ["destructive", "privilege", "credential"] },
        "pattern": { "type": "string", "minLength": 1, "maxLength": 500 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 300 },
        "credentialClass": { "enum": ["real-credential", "private-key", "suspected-credential", "placeholder"] },
        "enabled": { "type": "boolean" }
      }
    },
    "errorCode": {
      "type": "string",
      "enum": [
        "DJE-0001",
        "DJE-0002",
        "DJE-0003",
        "DJE-0004",
        "DJE-0005",
        "DJE-0006",
        "DJE-0007",
        "DJE-0008",
        "DJE-0009",
        "DJE-0010",
        "DJE-0011"
      ]
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "baseUrl",
        "model",
        "timeoutMs",
        "advisoryTimeoutMs",
        "askThreshold",
        "blockThreshold",
        "guardedTools",
        "loopGuard",
        "resultShaper",
        "tokenOptimization",
        "doneGate",
        "toolPruner",
        "skillRouter",
        "decisionTools",
        "deterministicSafetyGuard"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "baseUrl": { "type": "string", "format": "uri", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "advisoryTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "askThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "blockThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "guardedTools": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "loopGuard": { "$ref": "#/$defs/loopGuardConfig" },
        "resultShaper": { "$ref": "#/$defs/resultShaperConfig" },
        "tokenOptimization": { "$ref": "#/$defs/tokenOptimizationConfig" },
        "doneGate": { "$ref": "#/$defs/doneGateConfig" },
        "toolPruner": { "$ref": "#/$defs/toolPrunerConfig" },
        "skillRouter": { "$ref": "#/$defs/skillRouterConfig" },
        "decisionTools": { "$ref": "#/$defs/decisionToolsConfig" },
        "deterministicSafetyGuard": { "$ref": "#/$defs/deterministicSafetyGuardConfig" }
      }
    },
    "configPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "baseUrl": { "type": "string", "format": "uri", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "advisoryTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "askThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "blockThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "guardedTools": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "loopGuard": { "$ref": "#/$defs/loopGuardPatch" },
        "resultShaper": { "$ref": "#/$defs/resultShaperPatch" },
        "tokenOptimization": { "$ref": "#/$defs/tokenOptimizationPatch" },
        "doneGate": { "$ref": "#/$defs/doneGatePatch" },
        "toolPruner": { "$ref": "#/$defs/toolPrunerPatch" },
        "skillRouter": { "$ref": "#/$defs/skillRouterPatch" },
        "decisionTools": { "$ref": "#/$defs/decisionToolsPatch" },
        "deterministicSafetyGuard": { "$ref": "#/$defs/deterministicSafetyGuardPatch" }
      }
    },
    "runtimeCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumDshRuntime", "testedDshRuntime", "requiredFeatures"],
      "properties": {
        "minimumDshRuntime": { "type": "string" },
        "testedDshRuntime": { "type": "string" },
        "requiredFeatures": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "runtimeState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaceId", "userRequested", "effective", "available", "executing", "activeRequests", "updatedAt"],
      "properties": {
        "workspaceId": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string", "minLength": 1 },
        "userRequested": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "source"],
          "properties": {
            "enabled": { "type": "boolean" },
            "source": { "enum": ["default", "startup", "global", "workspace", "session", "next-turn"] }
          }
        },
        "effective": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "active", "values", "source"],
          "properties": {
            "enabled": { "type": "boolean" },
            "active": { "type": "boolean" },
            "values": { "$ref": "#/$defs/config" },
            "source": { "enum": ["default", "startup", "global", "workspace", "session", "next-turn"] }
          }
        },
        "available": { "type": "boolean" },
        "availabilityReason": { "type": "string" },
        "executing": { "type": "boolean" },
        "activeRequests": { "type": "integer", "minimum": 0 },
        "lastDecision": { "enum": ["allow", "ask", "deny", "skipped"] },
        "lastErrorCode": { "$ref": "#/$defs/errorCode" },
        "lastErrorMessage": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceId", "since", "resetAt", "totalCalls", "successfulCalls", "failedCalls",
        "timeoutCalls", "cancelledCalls", "skippedCalls", "allowDecisions", "askDecisions",
        "denyDecisions", "totalLatencyMs", "maxLatencyMs", "totalRequestBytes", "totalResponseBytes", "activeCalls",
        "loopGuardChecks", "loopGuardWarnings", "loopGuardInterruptions", "loopGuardUncertain",
        "doneGateChecks", "doneGateInterventions", "doneGateUncertain", "resultShaperCalls", "resultShaperCharsRemoved",
        "toolPrunerCalls", "toolPrunerSkipped", "toolPrunerLowConfidence", "toolPrunerFailOpen",
        "toolPrunerToolsSeen", "toolPrunerToolsKept", "toolPrunerRemovedChars", "toolPrunerLatencyMs",
        "skillRouterCalls", "skillRouterSkipped", "skillRouterLowConfidence", "skillRouterFailOpen",
        "skillRouterAdviceCount", "skillRouterAdviceChars", "skillRouterLatencyMs",
        "decisionToolCalls", "decisionToolUnknown", "decisionToolFailOpen", "decisionToolLatencyMs",
        "deterministicGuardChecks", "deterministicGuardDenies",
        "inputTokensBefore", "inputTokensAfter", "tokensRemoved", "decisionCalls", "decisionLatencyMs",
        "skippedLowRoi", "failures", "failOpen", "estimatedCostUsd", "cacheHitRate", "netTokensSaved",
        "lastFailureType", "lastFailureReason", "deterministicRuleHits", "credentialClassHits"
      ],
      "properties": {
        "workspaceId": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string", "minLength": 1 },
        "since": { "type": "string", "format": "date-time" },
        "resetAt": { "type": "string", "format": "date-time" },
        "totalCalls": { "type": "integer", "minimum": 0 },
        "successfulCalls": { "type": "integer", "minimum": 0 },
        "failedCalls": { "type": "integer", "minimum": 0 },
        "timeoutCalls": { "type": "integer", "minimum": 0 },
        "cancelledCalls": { "type": "integer", "minimum": 0 },
        "skippedCalls": { "type": "integer", "minimum": 0 },
        "allowDecisions": { "type": "integer", "minimum": 0 },
        "askDecisions": { "type": "integer", "minimum": 0 },
        "denyDecisions": { "type": "integer", "minimum": 0 },
        "totalLatencyMs": { "type": "number", "minimum": 0 },
        "maxLatencyMs": { "type": "number", "minimum": 0 },
        "totalRequestBytes": { "type": "integer", "minimum": 0 },
        "totalResponseBytes": { "type": "integer", "minimum": 0 },
        "activeCalls": { "type": "integer", "minimum": 0 },
        "loopGuardChecks": { "type": "integer", "minimum": 0 },
        "loopGuardWarnings": { "type": "integer", "minimum": 0 },
        "loopGuardInterruptions": { "type": "integer", "minimum": 0 },
        "loopGuardUncertain": { "type": "integer", "minimum": 0 },
        "doneGateChecks": { "type": "integer", "minimum": 0 },
        "doneGateInterventions": { "type": "integer", "minimum": 0 },
        "doneGateUncertain": { "type": "integer", "minimum": 0 },
        "resultShaperCalls": { "type": "integer", "minimum": 0 },
        "resultShaperCharsRemoved": { "type": "integer", "minimum": 0 },
        "toolPrunerCalls": { "type": "integer", "minimum": 0 },
        "toolPrunerSkipped": { "type": "integer", "minimum": 0 },
        "toolPrunerLowConfidence": { "type": "integer", "minimum": 0 },
        "toolPrunerFailOpen": { "type": "integer", "minimum": 0 },
        "toolPrunerToolsSeen": { "type": "integer", "minimum": 0 },
        "toolPrunerToolsKept": { "type": "integer", "minimum": 0 },
        "toolPrunerRemovedChars": { "type": "integer", "minimum": 0 },
        "toolPrunerLatencyMs": { "type": "number", "minimum": 0 },
        "skillRouterCalls": { "type": "integer", "minimum": 0 },
        "skillRouterSkipped": { "type": "integer", "minimum": 0 },
        "skillRouterLowConfidence": { "type": "integer", "minimum": 0 },
        "skillRouterFailOpen": { "type": "integer", "minimum": 0 },
        "skillRouterAdviceCount": { "type": "integer", "minimum": 0 },
        "skillRouterAdviceChars": { "type": "integer", "minimum": 0 },
        "skillRouterLatencyMs": { "type": "number", "minimum": 0 },
        "decisionToolCalls": { "type": "integer", "minimum": 0 },
        "decisionToolUnknown": { "type": "integer", "minimum": 0 },
        "decisionToolFailOpen": { "type": "integer", "minimum": 0 },
        "decisionToolLatencyMs": { "type": "number", "minimum": 0 },
        "deterministicGuardChecks": { "type": "integer", "minimum": 0 },
        "deterministicGuardDenies": { "type": "integer", "minimum": 0 },
        "inputTokensBefore": { "type": ["integer", "null"], "minimum": 0 },
        "inputTokensAfter": { "type": ["integer", "null"], "minimum": 0 },
        "tokensRemoved": { "type": ["integer", "null"], "minimum": 0 },
        "decisionCalls": { "type": "integer", "minimum": 0 },
        "decisionLatencyMs": { "type": "number", "minimum": 0 },
        "skippedLowRoi": { "type": "integer", "minimum": 0 },
        "failures": { "type": "integer", "minimum": 0 },
        "failOpen": { "type": "integer", "minimum": 0 },
        "estimatedCostUsd": { "type": ["number", "null"], "minimum": 0 },
        "cacheHitRate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "netTokensSaved": { "type": ["integer", "null"] },
        "lastFailureType": { "type": ["string", "null"], "enum": ["timeout", "network", "429", "5xx", "cancel", "invalid-response", "http", null] },
        "lastFailureReason": { "type": ["string", "null"], "maxLength": 200 },
        "deterministicRuleHits": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "credentialClassHits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["real-credential", "private-key", "suspected-credential", "placeholder"],
          "properties": {
            "real-credential": { "type": "integer", "minimum": 0 },
            "private-key": { "type": "integer", "minimum": 0 },
            "suspected-credential": { "type": "integer", "minimum": 0 },
            "placeholder": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "protocolError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name", "message", "retryable"],
      "properties": {
        "code": { "$ref": "#/$defs/errorCode" },
        "name": { "type": "string" },
        "message": { "type": "string" },
        "details": { "type": "object" },
        "retryable": { "type": "boolean" }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "error"],
      "properties": {
        "ok": { "const": false },
        "error": { "$ref": "#/$defs/protocolError" }
      }
    },
    "configUpdateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaceId", "scope", "patch"],
      "properties": {
        "workspaceId": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string", "minLength": 1 },
        "scope": { "enum": ["global", "workspace", "session", "next-turn"] },
        "patch": { "$ref": "#/$defs/configPatch" }
      }
    },
    "capabilitiesResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "integrationVersion", "integrationCommit", "protocolVersion", "runtimeCompatibility",
        "pluginMounted", "endpointAvailable", "capabilities", "jev"
      ],
      "properties": {
        "integrationVersion": { "type": "string" },
        "integrationCommit": { "type": "string" },
        "protocolVersion": { "type": "string" },
        "runtimeCompatibility": { "$ref": "#/$defs/runtimeCompatibility" },
        "pluginMounted": { "type": "boolean" },
        "endpointAvailable": { "type": "boolean" },
        "endpointReason": { "type": "string" },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "configRead", "configWrite", "stateRead", "statsRead", "statsReset",
            "stateEvents", "preExecuteHook", "postExecuteHook", "loopGuard", "resultShaper",
            "doneEvidenceGate", "turnStoppingHook", "nextTurnOverride",
            "toolPruner", "skillRouter", "decisionTools", "deterministicSafetyGuard",
            "tokenMeter", "toolResultPruner", "tokenOptimization"
          ],
          "properties": {
            "configRead": { "type": "boolean" },
            "configWrite": { "type": "boolean" },
            "stateRead": { "type": "boolean" },
            "statsRead": { "type": "boolean" },
            "statsReset": { "type": "boolean" },
            "stateEvents": { "type": "boolean" },
            "preExecuteHook": { "type": "boolean" },
            "postExecuteHook": { "type": "boolean" },
            "loopGuard": { "type": "boolean" },
            "resultShaper": { "type": "boolean" },
            "doneEvidenceGate": { "type": "boolean" },
            "turnStoppingHook": { "type": "boolean" },
            "nextTurnOverride": { "type": "boolean" },
            "toolPruner": { "type": "boolean" },
            "skillRouter": { "type": "boolean" },
            "decisionTools": { "type": "boolean" },
            "deterministicSafetyGuard": { "type": "boolean" },
            "tokenMeter": { "type": "boolean" },
            "toolResultPruner": { "type": "boolean" },
            "tokenOptimization": { "type": "boolean" }
          }
        },
        "jev": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseUrl", "model", "available"],
          "properties": {
            "baseUrl": { "type": "string" },
            "model": { "type": "string" },
            "available": { "type": "boolean" },
            "reason": { "type": "string" }
          }
        }
      }
    },
    "configResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaceId", "persisted", "scope", "source", "values"],
      "properties": {
        "workspaceId": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string", "minLength": 1 },
        "persisted": { "type": "boolean" },
        "scope": { "enum": ["global", "workspace", "session", "next-turn"] },
        "source": { "enum": ["default", "startup", "global", "workspace", "session", "next-turn"] },
        "values": { "$ref": "#/$defs/config" }
      }
    },
    "successEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "data"],
      "properties": {
        "ok": { "const": true },
        "data": { "type": "object" }
      }
    },
    "stateEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "at", "workspaceId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["state.changed", "config.changed", "stats.changed"] },
        "at": { "type": "string", "format": "date-time" },
        "workspaceId": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string", "minLength": 1 },
        "state": { "$ref": "#/$defs/runtimeState" },
        "stats": { "$ref": "#/$defs/statistics" }
      }
    }
  },
  "anyOf": [
    { "$ref": "#/$defs/config" },
    { "$ref": "#/$defs/configPatch" },
    { "$ref": "#/$defs/configUpdateRequest" },
    { "$ref": "#/$defs/capabilitiesResponse" },
    { "$ref": "#/$defs/configResponse" },
    { "$ref": "#/$defs/successEnvelope" },
    { "$ref": "#/$defs/runtimeState" },
    { "$ref": "#/$defs/statistics" },
    { "$ref": "#/$defs/protocolError" },
    { "$ref": "#/$defs/errorResponse" },
    { "$ref": "#/$defs/stateEvent" }
  ]
}
