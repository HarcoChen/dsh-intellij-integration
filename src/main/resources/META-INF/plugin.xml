<idea-plugin url="https://github.com/HarcoChen/dsh-intellij-integration">
    <id>top.harcochen.dsh</id>
    <name>DeepSeek Harness Integration</name>
    <resource-bundle>messages.DshBundle</resource-bundle>
    <vendor email="harcourtzzz@outlook.com" url="https://github.com/HarcoChen/dsh-intellij-integration">HarcoChen</vendor>
    <description><![CDATA[
        <p>Bring DeepSeek Harness (DSH) into IntelliJ IDEA, PyCharm, and other
        JetBrains IDEs. Chat with your code, review native diffs, and inspect
        agent activity without leaving your editor.</p>
        <ul>
            <li><b>Code-aware chat:</b> explain, fix, review, and document selected
            code from the editor context menu.</li>
            <li><b>Native diff previews:</b> inspect supported tool edits in the
            IDE's side-by-side viewer, including proposed changes awaiting
            approval. No Git repository required.</li>
            <li><b>Sessions and Trace:</b> revisit conversations, inspect tool
            cards, and explore session events with built-in Trace analysis.</li>
            <li><b>Balance at a glance:</b> view your DeepSeek balance and pricing
            information in the status bar when available.</li>
            <li><b>Local Runtime management:</b> start, stop, restart, or connect
            to a compatible existing Harness Runtime across editor windows.</li>
            <li><b>Secure credentials:</b> store API keys in IntelliJ Password Safe.</li>
            <li>English and Simplified Chinese interface resources.</li>
        </ul>
        <p><b>Get started:</b> open the DSH tool window, configure your API key,
        and ask a question or right-click a code selection. Runtime settings
        are under Settings &gt; Tools &gt; DeepSeek Harness.</p>
        <p><b>Requirements:</b> IntelliJ Platform 2024.3 or later with JCEF.
        Local Runtime startup requires Node.js with pnpm or npm/npx, or an
        installed dsh command. You can also connect to an existing Runtime.</p>
        <p><a href="https://github.com/HarcoChen/dsh-intellij-integration#readme">Getting started and configuration</a>
        | <a href="https://github.com/HarcoChen/dsh-intellij-integration/blob/main/README.zh-CN.md">简体中文指南</a>
        | <a href="https://github.com/HarcoChen/dsh-intellij-integration/issues">Report an issue</a></p>
        <p><b>Data use:</b> the plugin does not collect telemetry. Prompts and
        attached context are sent through the DSH Runtime to the model provider
        configured by the user.</p>
        <p>This is an independent community plugin and is not endorsed or
        maintained by DeepSeek or JetBrains.</p>
    ]]></description>
    <idea-version since-build="243" />
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <!--
      Since 2026.2 JCEF is delivered as a bundled modular plugin. Keeping this
      dependency optional preserves 2024.3 compatibility while ensuring that,
      when present, JCEF finishes loading before this plugin can query it.
    -->
    <depends optional="true" config-file="top.harcochen.dsh-withJcef.xml">com.intellij.modules.jcef</depends>
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="DSH" anchor="right" icon="/icons/dsh.svg"
                    factoryClass="top.harcochen.dsh.DshToolWindowFactory"
                    canCloseContent="false"/>
        <projectService serviceImplementation="top.harcochen.dsh.DshRuntimeService"/>
        <projectService serviceImplementation="top.harcochen.dsh.remote.DshRemoteService"/>
        <projectService serviceImplementation="top.harcochen.dsh.DshSettingsState"/>
        <projectConfigurable parentId="tools" id="top.harcochen.dsh.settings"
                             displayName="DeepSeek Harness"
                             instance="top.harcochen.dsh.DshSettingsConfigurable"/>
        <notificationGroup id="DeepSeek Harness" displayType="BALLOON" />
        <statusBarWidgetFactory id="DshBalance"
                                implementation="top.harcochen.dsh.DshBalanceWidget$Factory"
                                order="after Position"/>
    </extensions>
    <actions>
        <action id="Dsh.Open" class="top.harcochen.dsh.action.DshOpenAction"
                icon="/icons/dsh.svg">
            <add-to-group group-id="ToolsMenu" anchor="last" />
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift alt D" />
        </action>
        <action id="Dsh.Start" class="top.harcochen.dsh.action.DshStartAction" />
        <action id="Dsh.Stop" class="top.harcochen.dsh.action.DshStopAction" />
        <action id="Dsh.Restart" class="top.harcochen.dsh.action.DshRestartAction" />
        <action id="Dsh.NewSession" class="top.harcochen.dsh.action.DshNewSessionAction" />
        <action id="Dsh.OpenBrowser" class="top.harcochen.dsh.action.DshCommandAction" />
        <action id="Dsh.OpenLogs" class="top.harcochen.dsh.action.DshCommandAction" />
        <action id="Dsh.ConfigureApiKey" class="top.harcochen.dsh.action.DshCommandAction" />
        <action id="Dsh.ManageProviders" class="top.harcochen.dsh.action.DshCommandAction" />
        <action id="Dsh.ManageAgentPresets" class="top.harcochen.dsh.action.DshCommandAction" />
        <action id="Dsh.Diagnose" class="top.harcochen.dsh.action.DshCommandAction" />
        <action id="Dsh.AskAboutSelection" class="top.harcochen.dsh.action.DshAskAboutSelectionAction">
            <add-to-group group-id="EditorPopupMenu" anchor="last" />
        </action>
        <action id="Dsh.AskAboutResource" class="top.harcochen.dsh.action.DshAskAboutResourceAction">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last" />
            <add-to-group group-id="EditorTabPopupMenu" anchor="last" />
        </action>
        <action id="Dsh.InsertEditorReference" class="top.harcochen.dsh.action.DshInsertEditorReferenceAction" />
        <action id="Dsh.ExplainDebugState" class="top.harcochen.dsh.action.DshExplainDebugStateAction">
            <add-to-group group-id="XDebugger.ToolBar" anchor="last" />
        </action>
        <action id="Dsh.ExplainDiff" class="top.harcochen.dsh.action.DshGitDiffTaskAction" />
        <action id="Dsh.FixDiff" class="top.harcochen.dsh.action.DshGitDiffTaskAction" />
        <action id="Dsh.ReviewDiff" class="top.harcochen.dsh.action.DshGitDiffTaskAction" />
        <action id="Dsh.DocsDiff" class="top.harcochen.dsh.action.DshGitDiffTaskAction" />
        <group id="Dsh.GitDiffTasks" popup="true">
            <add-to-group group-id="Vcs.ContextMenu" anchor="last" />
            <reference ref="Dsh.ExplainDiff" />
            <reference ref="Dsh.FixDiff" />
            <reference ref="Dsh.ReviewDiff" />
            <reference ref="Dsh.DocsDiff" />
        </group>
        <action id="Dsh.Explain" class="top.harcochen.dsh.action.DshQuickTaskAction" />
        <action id="Dsh.Fix" class="top.harcochen.dsh.action.DshQuickTaskAction" />
        <action id="Dsh.Review" class="top.harcochen.dsh.action.DshQuickTaskAction" />
        <action id="Dsh.Docs" class="top.harcochen.dsh.action.DshQuickTaskAction" />
        <group id="Dsh.EditorTasks" popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="last" />
            <reference ref="Dsh.Explain" />
            <reference ref="Dsh.Fix" />
            <reference ref="Dsh.Review" />
            <reference ref="Dsh.Docs" />
        </group>
    </actions>
</idea-plugin>
