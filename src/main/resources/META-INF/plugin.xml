<idea-plugin url="https://github.com/HarcoChen/dsh-intellij-integration">
    <id>top.harcochen.dsh</id>
    <name>DeepSeek Harness Integration</name>
    <resource-bundle>messages.DshBundle</resource-bundle>
    <vendor email="harcourtzzz@outlook.com" url="https://github.com/HarcoChen/dsh-intellij-integration">HarcoChen</vendor>
    <description><![CDATA[
        <p>An independent community integration for using DeepSeek Harness (DSH)
        inside IntelliJ Platform IDEs.</p>
        <ul>
            <li>Embedded chat, sessions, history, tool cards, and runtime status</li>
            <li>Editor-aware explain, fix, review, and documentation prompts</li>
            <li>Local DSH Runtime lifecycle management and diagnostics</li>
            <li>API keys stored with IntelliJ Password Safe</li>
        </ul>
        <p><b>Requirements:</b> a JetBrains IDE with bundled JCEF, plus Node.js
        with pnpm or npm/npx available when the plugin launches the Runtime.</p>
        <p><b>Data use:</b> the plugin does not collect telemetry. Prompts and
        explicitly attached editor selections are sent through the local DSH
        Runtime to the model provider configured by the user.</p>
        <p>This is an unofficial community plugin and is not endorsed or
        maintained by DeepSeek or JetBrains.</p>
    ]]></description>
    <idea-version since-build="243" />
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <!--
      Since 2026.2 JCEF is delivered as a bundled modular plugin. Keeping this
      dependency optional preserves 2024.3 compatibility while ensuring that,
      when present, JCEF finishes loading before this plugin can query it.
    -->
    <depends optional="true" config-file="top.harcochen.dsh-withJcef.xml">com.intellij.modules.jcef</depends>
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="DSH" anchor="right" icon="/icons/dsh.svg"
                    factoryClass="top.harcochen.dsh.DshToolWindowFactory"
                    canCloseContent="false"/>
        <projectService serviceImplementation="top.harcochen.dsh.DshRuntimeService"/>
        <projectService serviceImplementation="top.harcochen.dsh.DshSettingsState"/>
        <projectConfigurable parentId="tools" id="top.harcochen.dsh.settings"
                             displayName="DeepSeek Harness"
                             instance="top.harcochen.dsh.DshSettingsConfigurable"/>
        <notificationGroup id="DeepSeek Harness" displayType="BALLOON" />
        <statusBarWidgetFactory id="DshBalance"
                                implementation="top.harcochen.dsh.DshBalanceWidget$Factory"
                                order="after Position"/>
    </extensions>
    <actions>
        <action id="Dsh.Open" class="top.harcochen.dsh.action.DshOpenAction"
                icon="/icons/dsh.svg">
            <add-to-group group-id="ToolsMenu" anchor="last" />
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift alt D" />
        </action>
        <action id="Dsh.Start" class="top.harcochen.dsh.action.DshStartAction" />
        <action id="Dsh.Stop" class="top.harcochen.dsh.action.DshStopAction" />
        <action id="Dsh.Restart" class="top.harcochen.dsh.action.DshRestartAction" />
        <action id="Dsh.NewSession" class="top.harcochen.dsh.action.DshNewSessionAction" />
        <action id="Dsh.OpenBrowser" class="top.harcochen.dsh.action.DshCommandAction" />
        <action id="Dsh.OpenLogs" class="top.harcochen.dsh.action.DshCommandAction" />
        <action id="Dsh.ConfigureApiKey" class="top.harcochen.dsh.action.DshCommandAction" />
        <action id="Dsh.ManageProviders" class="top.harcochen.dsh.action.DshCommandAction" />
        <action id="Dsh.ManageAgentPresets" class="top.harcochen.dsh.action.DshCommandAction" />
        <action id="Dsh.Diagnose" class="top.harcochen.dsh.action.DshCommandAction" />
        <action id="Dsh.AskAboutSelection" class="top.harcochen.dsh.action.DshAskAboutSelectionAction">
            <add-to-group group-id="EditorPopupMenu" anchor="last" />
        </action>
        <action id="Dsh.Explain" class="top.harcochen.dsh.action.DshQuickTaskAction" />
        <action id="Dsh.Fix" class="top.harcochen.dsh.action.DshQuickTaskAction" />
        <action id="Dsh.Review" class="top.harcochen.dsh.action.DshQuickTaskAction" />
        <action id="Dsh.Docs" class="top.harcochen.dsh.action.DshQuickTaskAction" />
        <group id="Dsh.EditorTasks" popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="last" />
            <reference ref="Dsh.Explain" />
            <reference ref="Dsh.Fix" />
            <reference ref="Dsh.Review" />
            <reference ref="Dsh.Docs" />
        </group>
    </actions>
</idea-plugin>
